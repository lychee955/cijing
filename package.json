{
  "name": "cijing",
  "version": "0.0.2-snapshot.20261005.1",
  "private": true,
  "description": "词境 · 英语查词、句子解析与生词收录",
  "author": "lychee955",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "node node_modules/electron/install.js && electron-rebuild -f -w better-sqlite3",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit",
    "icons": "node scripts/make-icon.cjs",
    "build": "npm run icons && npm run typecheck && electron-vite build",
    "dist": "npm run build && node scripts/package-release.cjs",
    "test": "node scripts/test.cjs",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,vue,json,css,scss,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,cjs,mjs,vue,json,css,scss,html}\"",
    "check": "npm run format:check && npm run test && npm run build",
    "release:verify": "node scripts/verify-release.cjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs,vue,json,css,scss,html}": "prettier --write"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.9",
    "js-yaml": "4.3.2",
    "pinia": "4.0.3",
    "semver": "7.8.5",
    "vue": "3.5.42",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.13.4",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.8.5",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  }
}
